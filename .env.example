# ─────────── قاعدة البيانات ───────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# عنوان الموقع العام (يستخدم بالسيو و sitemap)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─────────── هوية المتجر العامة (تظهر بالواجهة) ───────────
# رقم الدعم — يظهر بالفوتر وأزرار الواتساب (11 رقماً يبدأ 07، أو صيغة دولية 964)
NEXT_PUBLIC_SUPPORT_PHONE=07700001122
# رقم الواتساب إن اختلف عن رقم الدعم (اختياري)
NEXT_PUBLIC_WHATSAPP_PHONE=07700001122

# ─────────── رصد السوق: Google عبر Serper ───────────
SERPER_API_KEY=

# ─────────── بوابات الدفع العراقية (إنتاج) ───────────
# زين كاش — البوابة الرئيسية
ZAINCASH_MSISDN=
ZAINCASH_MERCHANT_ID=
ZAINCASH_SECRET=
# FIB — المصرف العراقي للتجارة
FIB_CLIENT_ID=
FIB_CLIENT_SECRET=
# كي كارد (MasterCard Iraq)
QICARD_API_KEY=
QICARD_TERMINAL_ID=
# آسيا حوالة
ASIAHAWALA_MERCHANT=
ASIAHAWALA_SECRET=
# فاست باي
FASTPAY_STORE_ID=
FASTPAY_PASSWORD=
# هواوي باي
HUAWEI_PAY_MERCHANT_ID=
HUAWEI_PAY_KEY_ID=

# ─────────── لوحة التحكم (إلزامي للإنتاج) ───────────
# رمز دخول /admin — لا توجد قيمة ثابتة بالكود؛ بدونها تُستخدم قيمة تطوير مؤقتة 2024
ADMIN_PIN=
# سر توقيع كوكي جلسة الإدارة — غيّره لسلسلة عشوائية طويلة في الإنتاج
ADMIN_SESSION_SECRET=

# ─────────── الإشعارات والرسائل ───────────
# Firebase Cloud Messaging (إشعارات التطبيق/PWA)
FCM_SERVER_KEY=
FCM_SENDER_ID=
# مزود SMS عراقي محلي (OTP + فواتير)
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=SIGHAR

# ─────────── تخزين الصور (إنتاج) ───────────
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Redis (تخزين مؤقت — اختياري)
REDIS_URL=redis://127.0.0.1:6379
